@@ -98,6 +98,145 @@
 
 static complex double cSamples[SAMP_BUFFER_SIZE];			// Complex buffer for samples
 
+/* ---------------------------------------------------------------------------
+ * Smooth rate matching for the Tx I/Q sound card (quisk_MicPlayback).
+ *
+ * The old method kept the play buffer near 50% full by dropping or duplicating
+ * one whole sample every so often. On the Tx I/Q stream that makes a phase jump
+ * in the transmitted signal and so a broadband click/tick on the air.
+ *
+ * Now the Tx I/Q stream is never touched. Instead, the mic/digital samples are
+ * resampled at baseband (before tuning to the Tx frequency and before the I/Q
+ * amplitude/phase corrections) by a windowed-sinc fractional resampler whose
+ * ratio is set by a PI controller on the play buffer fill. In CW the carrier is
+ * generated by Quisk, so the same ratio simply adjusts how many samples are
+ * made, which is phase continuous.
+ *
+ * Set tx_smooth_rate = 0 with QS.set_sparams() to go back to the old method for A/B tests.
+ * ------------------------------------------------------------------------- */
+static int tx_smooth_rate = 1;			// 1: use the smooth method; 0: old add/drop method
+#define TXRS_TAPS	24			// number of filter taps; even
+#define TXRS_PHASES	256			// number of fractional phases in the table
+#define TXRS_PERIOD	AVG_SEC_TX		// controller update period in seconds
+#define AVG_SEC_TX	10.0
+#define TXRS_MAX_RATIO	0.005			// maximum rate correction +/- 0.5%
+static double txrs_coef[TXRS_PHASES + 1][TXRS_TAPS];
+static complex double txrs_buf[TXRS_TAPS + SAMP_BUFFER_SIZE];
+static complex double txrs_out[SAMP_BUFFER_SIZE];
+static int txrs_nbuf = 0;			// number of samples in txrs_buf
+static double txrs_pos = 0;			// fractional read position in txrs_buf
+static double txrs_ratio = 1.0;			// output samples / input samples
+static double txrs_integ = 0;			// integral part of the controller
+static int txrs_init = 0;
+
+static double txrs_bessel_i0(double x)
+{
+	double sum = 1, term = 1, y = x * x / 4;
+	int k;
+	for (k = 1; k < 50; k++) {
+		term *= y / ((double)k * k);
+		sum += term;
+		if (term < sum * 1e-17)
+			break;
+	}
+	return sum;
+}
+
+static void txrs_make_table(void)
+{	// Kaiser windowed sinc; cutoff 0.4 * sample rate; each phase normalized to unity DC gain
+	int p, t;
+	double frac, x, w, h, sum, beta = 8.6, half = TXRS_TAPS / 2.0, fc = 0.8;
+	for (p = 0; p <= TXRS_PHASES; p++) {
+		frac = (double)p / TXRS_PHASES;
+		sum = 0;
+		for (t = 0; t < TXRS_TAPS; t++) {
+			x = t - (half - 1) - frac;	// distance from the interpolation point
+			h = (x == 0) ? fc : sin(M_PI * fc * x) / (M_PI * x);
+			w = x / half;
+			w = (fabs(w) >= 1.0) ? 0.0 : txrs_bessel_i0(beta * sqrt(1.0 - w * w)) / txrs_bessel_i0(beta);
+			txrs_coef[p][t] = h * w;
+			sum += h * w;
+		}
+		for (t = 0; t < TXRS_TAPS; t++)
+			txrs_coef[p][t] /= sum;
+	}
+	txrs_init = 1;
+}
+
+static void txrs_reset(void)
+{
+	txrs_nbuf = 0;
+	txrs_pos = 0;
+}
+
+static int txrs_process(complex double * samples, int nSamples, double ratio)
+{	// Resample samples in place by ratio (output/input). Returns the new number of samples.
+	int i, t, ip, k, nout, total;
+	double step, pos, frac, a, c;
+	complex double sum, * pt;
+
+	if ( ! txrs_init)
+		txrs_make_table();
+	if (nSamples <= 0)
+		return nSamples;
+	if (txrs_nbuf == 0) {		// prime with zeros so the output starts immediately
+		for (i = 0; i < TXRS_TAPS - 1; i++)
+			txrs_buf[i] = 0;
+		txrs_nbuf = TXRS_TAPS - 1;
+		txrs_pos = 0;
+	}
+	if (txrs_nbuf + nSamples > TXRS_TAPS + SAMP_BUFFER_SIZE)
+		nSamples = TXRS_TAPS + SAMP_BUFFER_SIZE - txrs_nbuf;
+	memcpy(txrs_buf + txrs_nbuf, samples, nSamples * sizeof(complex double));
+	total = txrs_nbuf + nSamples;
+	step = 1.0 / ratio;
+	pos = txrs_pos;
+	nout = 0;
+	while (pos + TXRS_TAPS <= total && nout < SAMP_BUFFER_SIZE) {
+		ip = (int)pos;
+		frac = (pos - ip) * TXRS_PHASES;
+		k = (int)frac;
+		a = frac - k;
+		pt = txrs_buf + ip;
+		sum = 0;
+		for (t = 0; t < TXRS_TAPS; t++) {
+			c = txrs_coef[k][t] + a * (txrs_coef[k + 1][t] - txrs_coef[k][t]);
+			sum += pt[t] * c;
+		}
+		txrs_out[nout++] = sum;
+		pos += step;
+	}
+	ip = (int)pos;			// discard samples that are no longer needed
+	if (ip > total)
+		ip = total;
+	txrs_nbuf = total - ip;
+	memmove(txrs_buf, txrs_buf + ip, txrs_nbuf * sizeof(complex double));
+	txrs_pos = pos - ip;
+	memcpy(samples, txrs_out, nout * sizeof(complex double));
+	return nout;
+}
+
+static void txrs_update_ratio(struct sound_dev * dev, double fill)
+{	// PI controller on the average buffer fill; called every AVG_SEC seconds.
+	// Critically damped for the update period: proportional gain 0.4, integral gain 0.04 per period.
+	double err_frames, fs;
+
+	fs = dev->sample_rate;
+	if (fs <= 0 || dev->play_buf_size <= 0)
+		return;
+	err_frames = (0.5 - fill) * dev->play_buf_size;		// frames we need to add to reach 50%
+	txrs_integ += 0.04 * err_frames / (fs * TXRS_PERIOD);
+	if (txrs_integ > TXRS_MAX_RATIO)
+		txrs_integ = TXRS_MAX_RATIO;
+	else if (txrs_integ < -TXRS_MAX_RATIO)
+		txrs_integ = -TXRS_MAX_RATIO;
+	txrs_ratio = 1.0 + txrs_integ + 0.4 * err_frames / (fs * TXRS_PERIOD);
+	if (txrs_ratio > 1.0 + TXRS_MAX_RATIO)
+		txrs_ratio = 1.0 + TXRS_MAX_RATIO;
+	else if (txrs_ratio < 1.0 - TXRS_MAX_RATIO)
+		txrs_ratio = 1.0 - TXRS_MAX_RATIO;
+}
+
